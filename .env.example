# Copiar a .env.local y completar. NUNCA commitear .env.local.
# Los valores requeridos estan validados con Zod en lib/env.ts.

# --- Supabase ---------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypassea RLS: solo server-side, nunca en componentes cliente ni en scripts commiteados.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
# URL publica desde la que se accede a la app. En dev con Tailscale usar la IP
# de la interfaz Tailscale para que los QR de mesa apunten a un host alcanzable
# desde el celular, p. ej. http://100.x.y.z:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Secretos de la app -----------------------------------------------------
# Strings arbitrarios de 32 caracteres o mas.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Firma el JWT de sesion del comensal (cookie mesaqr_diner).
DINER_JWT_SECRET=

# Cifra restaurant_config.mp_access_token en la base (AES-256-GCM).
# Si cambia, los tokens de Mercado Pago ya guardados dejan de poder desencriptarse.
CONFIG_ENCRYPTION_KEY=

# --- Mercado Pago (opcional) ------------------------------------------------
# El access token productivo se carga desde el panel de admin y se guarda cifrado
# en la base; estas variables son solo para pruebas locales.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Observabilidad (opcional) ----------------------------------------------
SENTRY_DSN=
